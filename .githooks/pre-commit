#!/bin/sh
# Pre-commit hook - Run TypeScript type checking and Rust formatting on staged files
# Works in both the main repo and git worktrees by resolving the repo root first.

echo "🔍 Running pre-commit checks..."

# Resolve the repo root (works in worktrees too — git rev-parse returns the worktree root)
REPO_ROOT=$(git rev-parse --show-toplevel)
cd "$REPO_ROOT" || exit 1

# Check if any Rust files are staged
STAGED_RS_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '^backend/.*\.rs$' || true)

if [ -n "$STAGED_RS_FILES" ]; then
  echo "🦀 Rust files changed, running cargo fmt check..."

  cd backend

  if ! cargo fmt -- --check > /dev/null 2>&1; then
    echo "❌ Rust formatting errors found! Run 'cargo fmt' in backend/ to fix."
    exit 1
  fi

  echo "✅ Rust formatting check passed"

  echo "🔍 Running cargo clippy..."
  if ! cargo clippy -- -D warnings 2>&1 | tail -5; then
    echo "❌ Clippy warnings found! Run 'cargo clippy -- -D warnings' in backend/ to see details."
    exit 1
  fi

  echo "✅ Clippy check passed"
  cd "$REPO_ROOT"
fi

# Check if any frontend TypeScript or CSS files are staged (src/ and plugins/)
STAGED_FE_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '^frontend/.*\.(ts|tsx|css)$' || true)

if [ -n "$STAGED_FE_FILES" ]; then
  cd frontend

  # Install dependencies if node_modules is missing (worktree support)
  if [ ! -d "node_modules" ]; then
    echo "📦 node_modules not found — running npm install..."
    if ! npm install --prefer-offline --silent; then
      echo "❌ npm install failed."
      exit 1
    fi
    echo "✅ npm install complete"
  fi

  # Type check only when TypeScript files changed (skips the build for CSS-only commits)
  STAGED_TS_FILES=$(printf '%s\n' "$STAGED_FE_FILES" | grep -E '\.(ts|tsx)$' || true)
  if [ -n "$STAGED_TS_FILES" ]; then
    echo "📝 TypeScript files changed, running type check..."
    if ! npm run build > /dev/null 2>&1; then
      echo "❌ TypeScript errors found! Run 'npm run build' in frontend/ to see details."
      exit 1
    fi
    echo "✅ TypeScript check passed"
  fi

  # ESLint + theme colour guard
  echo "🔍 Running ESLint + theme colour check..."
  if ! npm run lint > /dev/null 2>&1; then
    echo "❌ Lint errors found! Run 'npm run lint' in frontend/ to see details."
    echo "Tip: 'npm run lint -- --fix' for ESLint; use theme tokens (--ls-*/--color-*) for the colour check (.agents/skills/graditone-theming)."
    exit 1
  fi

  echo "✅ Lint passed"
  cd "$REPO_ROOT"
fi

echo "✅ Pre-commit checks passed"
exit 0
