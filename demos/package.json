{
  "name": "graditone-demos",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Declarative user-flow demo video generator for Graditone (Playwright capture + DemoClip post-processing)",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "demo": "node src/run.ts",
    "demo:all": "node src/run.ts --all",
    "demo:list": "node src/run.ts --list",
    "catalog:build": "node src/tools/build-index.ts",
    "catalog:find": "node src/tools/find-element.ts",
    "flow:author": "node src/tools/author-flow.ts",
    "test": "node --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "playwright": "^1.64.1",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3"
  }
}
