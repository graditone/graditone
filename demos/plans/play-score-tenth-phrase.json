    { "phrase": "next phrase", "action": "click", "caption": "Step to the tenth phrase.", "hold": 250 },
    { "phrase": "next phrase", "action": "click", "hold": 250 },
    { "phrase": "next phrase", "action": "click", "hold": 250 },
    { "phrase": "next phrase", "action": "click", "hold": 250 },
    { "phrase": "next phrase", "action": "click", "hold": 250 },
    { "phrase": "next phrase", "action": "click", "hold": 250 },
    { "phrase": "next phrase", "action": "click", "hold": 250 },
    { "phrase": "next phrase", "action": "click", "hold": 250 },
    { "phrase": "next phrase", "action": "click", "hold": 250 },
    { "phrase": "next phrase", "action": "click", "hold": 1200 },
    {
      "phrase": "press play",
      "action": "click",
      "caption": "Press ▶ Play to reproduce the tenth phrase.",
      "hold": 5000
